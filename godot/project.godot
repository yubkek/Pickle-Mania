; Engine configuration file.
; Generated for Godot Engine 4.x
; https://godotengine.org/
; DO NOT EDIT THIS FILE MANUALLY unless you know what you are doing.

config_version=5

[application]

config/name="Pickle Mania"
config/description="Pickleball RPG - campaign, loot, superpowers"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

GameData="*res://scripts/GameData.gd"
GameState="*res://scripts/GameState.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input]

touch/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.039, 0.039, 0.102, 1)
